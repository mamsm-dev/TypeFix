# Maintainer: mamsm-dev <mamsm-dev@users.noreply.github.com>
pkgname=typefix
pkgver=0.1.0
pkgrel=1
pkgdesc="Keyboard layout mistake detector for English and Persian (X11)"
arch=('x86_64' 'aarch64')
url="https://github.com/mamsm-dev/TypeFix"
license=('MIT')
depends=('libxkbcommon' 'xorg-setxkbmap' 'glibc' 'gcc-libs')
optdepends=('libnotify: desktop notifications for suggestions')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir() {
  # GitHub names the extracted directory <repo>-<version>.
  echo "$srcdir"/*-"$pkgver"
}

build() {
  cd "$(_srcdir)/linux"
  export CARGO_TARGET_DIR=target
  cargo build --release --bin typefix
}

package() {
  local root
  root="$(_srcdir)"
  install -Dm755 "$root/linux/target/release/typefix" "$pkgdir/usr/bin/typefix"
  install -Dm644 "$root/Resources/en_50k.txt" "$pkgdir/usr/share/typefix/en_50k.txt"
  install -Dm644 "$root/Resources/fa_50k.txt" "$pkgdir/usr/share/typefix/fa_50k.txt"
  install -Dm644 "$root/linux/packaging/typefix.desktop" "$pkgdir/usr/share/applications/typefix.desktop"
  install -Dm644 "$root/icon/icon_1024.png" "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/typefix.png"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
